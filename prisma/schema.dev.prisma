// SQLite schema for local dev (used with MOCK_AUTH=true / MOCK_AI=true)
// Array fields become Json — Prisma serializes them automatically.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DEV_DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       CreatorProfile?
  ideas         Idea[]
  contentItems  ContentItem[]
  posts         Post[]
  goals         Goal[]
  challengeLogs ChallengeLog[]
  weeklyReviews WeeklyReview[]
  streaks       Streak[]
}

model CreatorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  niche             String
  contentCategories String   @default("[]")  // JSON-encoded string[]
  platforms         String   @default("[]")  // JSON-encoded Platform[]
  postingFrequency  Int
  availableHours    Int
  experienceLevel   String   @default("BEGINNER")
  primaryGoal       String
  tone              String
  targetAudience    String
  onboardingDone    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Idea {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  format      String
  platform    String
  hooks       String   @default("[]")  // JSON-encoded string[]
  status      String   @default("SAVED")
  contentItem ContentItem?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentItem {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId     String?   @unique
  idea       Idea?     @relation(fields: [ideaId], references: [id])
  title      String
  platform   String
  format     String
  status     String    @default("IDEA")
  targetDate DateTime?
  notes      String?
  scripts    Script[]
  post       Post?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Script {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  version       Int         @default(1)
  body          String
  aiFeedback    String?     // JSON string
  shotList      String?     // JSON string
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Post {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItemId String?      @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id])
  platform      String
  url           String?
  publishedAt   DateTime
  metrics       PostMetric[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PostMetric {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  views      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  saves      Int?
  recordedAt DateTime @default(now())
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period        String   @default("WEEKLY")
  targetPosts   Int
  targetScripts Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Streak {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current      Int       @default(0)
  longest      Int       @default(0)
  lastActiveAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model ChallengeLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  completedAt DateTime @default(now())
}

model WeeklyReview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart     DateTime
  summary       String
  achievements  String   @default("[]")  // JSON-encoded string[]
  improvements  String   @default("[]")  // JSON-encoded string[]
  priorities    String   @default("[]")  // JSON-encoded string[]
  suggestedPlan String?
  createdAt     DateTime @default(now())
}
