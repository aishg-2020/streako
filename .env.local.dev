# Local dev environment — no real keys needed
# Copy this to .env.local and run: npm run dev:setup

# Flags
MOCK_AUTH=true
MOCK_AI=true

# SQLite file DB (created by dev:setup)
DEV_DATABASE_URL=file:./dev.db

# Dummy values to prevent Next.js env warnings (not used when mocks are on)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
